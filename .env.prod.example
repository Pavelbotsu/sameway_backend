# Copy to `.env` next to docker-compose.prod.yml and fill in. The compose
# file refuses to start when DOMAIN / JWT_SECRET / DB_PASSWORD are missing.

# Your DuckDNS (or other) domain, pointed at this server's public IP.
DOMAIN=sameway.duckdns.org

# Generate with:  openssl rand -base64 48
JWT_SECRET=

# Strong random password for the PostGIS container (internal-only network,
# but never leave it as a dictionary word).  openssl rand -base64 24
DB_PASSWORD=

# Optional — token lifetime in hours (default 168 = 7 days).
#JWT_TTL_HOURS=168

# Optional — email delivery for password reset / verification codes.
#RESEND_API_KEY=
#EMAIL_FROM=noreply@yourdomain.com

# Optional — AI ranker (leave off unless a fresh, uncommitted key exists).
#AI_RANKER_ENABLED=false
#AI_PROVIDER_URL=
#AI_PROVIDER_API_KEY=
#AI_MODEL_NAME=

# Routing. Default is the public OSRM demo server (rate-limited, not for real
# load). Point at a self-hosted OSRM before scaling up. With APP_ENV=prod the
# server refuses to boot against the demo server unless ALLOW_PUBLIC_OSRM=true
# is set explicitly (see docker-compose.prod.yml).
#OSRM_BASE_URL=http://router.project-osrm.org

# ── Matching ────────────────────────────────────────────────────────────────
# How long a driver's last GPS fix stays usable for matching, in seconds.
# Every match path gates on this; a driver whose fix is older than this window
# is invisible to passengers. Keep it comfortably above the client's location
# ping interval (10s) plus Android background scheduling jitter.
#MATCH_LOC_FRESH_S=120

# ── Chat (Round 2) ───────────────────────────────────────────────────────────
# Retention policy: conversations between users who never completed a ride
# together are deleted (with their messages) after this many days without a
# message. Conversations with a completed ride are kept indefinitely.
#CHAT_RETENTION_NO_RIDE_DAYS=90
# Anti-spam: messages/minute per sender per conversation before the pair has
# completed a ride together.
#CHAT_PRE_RIDE_MAX_PER_MIN=5
# A passenger may only open a chat with a driver visible in their nearby view
# within this radius (km).
#CHAT_CANDIDATE_RADIUS_KM=10

# ── Partial relay / GTFS (Round 2) ──────────────────────────────────────────
# Static GTFS feed for transit-stop awareness at relay dropoffs. Leave unset
# to disable transit lookups (relay then gates on second-leg driver density
# only). Kraków: https://gtfs.ztp.krakow.pl/ (check current file name +
# license before enabling in production).
#GTFS_STATIC_URL=
#GTFS_STOP_RADIUS_M=300
#GTFS_REFRESH_DAYS=7
#MATCH_RELAY_MIN_DRIVERS=2

# ── Micro-detour (Round 2) ──────────────────────────────────────────────────
# Per-candidate caps (both must hold) and the per-route cumulative budget.
#MATCH_MAX_DETOUR_M=300
#MATCH_MAX_DETOUR_S=90
#MATCH_MAX_DETOUR_TOTAL_M=600
#MATCH_MAX_DETOUR_TOTAL_S=180
